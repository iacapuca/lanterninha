{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": { "browser": true, "es2024": true, "node": true },
  "settings": { "react": { "version": "19" } },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    // Provider syncs await one request at a time on purpose (polite pacing).
    "no-await-in-loop": "off",
    // Sorting freshly built arrays in place is fine.
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "oxc/no-map-spread": "off",
    "no-shadow": "off",
    // Auth forms focus their first field on purpose; role="img" on the lantern rating is valid ARIA.
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "drizzle/**",
    "migrations/**",
    // shadcn/ui components are vendored as generated.
    "src/components/ui/**"
  ]
}

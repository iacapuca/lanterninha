{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanterninha",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  // lanterninha.review is canonical; www and *.workers.dev 301 to it (src/server.ts).
  // Kept on (routes turn it off by default) so old links reach the redirect.
  "workers_dev": true,
  "routes": [
    { "pattern": "lanterninha.review", "custom_domain": true },
    { "pattern": "www.lanterninha.review", "custom_domain": true }
  ],
  "vars": {
    "SLOW_QUERY_MS": "0",
    // Ingresso.com content API: our partnership id and how many theaters' sessions to refresh per run.
    "INGRESSO_PARTNERSHIP": "lanterninha",
    "INGRESSO_THEATER_BATCH": "12",
    // Set to a relay's URL that forwards /v0/* to api-content.ingresso.com verbatim
    // (see README) to get around Akamai's 403 to Worker egress. Empty = call directly.
    "INGRESSO_PROXY_URL": "",
    // Velox Tickets: cap on venues refreshed per */30 run (all of them today), and page fetches in flight.
    "VELOX_THEATER_BATCH": "150",
    "VELOX_CONCURRENCY": "2"
  },
  // Provider syncs (src/server/programme/*/sync.server.ts), one invocation each. Ingresso's API is behind Akamai,
  // which 403s production Worker egress — set INGRESSO_PROXY_URL to a relay (see README) or
  // wait for their partner program; the cron retries harmlessly meanwhile.
  "triggers": { "crons": ["*/5 * * * *", "*/30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lanterninha",
      "database_id": "9f3f154b-66fc-4254-b348-3ee34960a750",
      // Flat SQL files copied from drizzle/ by db/sync-migrations.ts.
      "migrations_dir": "migrations"
    }
  ]
}

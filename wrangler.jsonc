{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanterninha",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "vars": {
    "SLOW_QUERY_MS": "0",
    // Ingresso.com content API: our partnership id and how many theaters' sessions to refresh per run.
    "INGRESSO_PARTNERSHIP": "lanterninha",
    "INGRESSO_THEATER_BATCH": "15"
  },
  // Ingresso.com sync (src/server/ingresso/sync.server.ts) is paused: Ingresso's CDN answers
  // 403 to requests from Cloudflare. Re-enable with ["*/5 * * * *"] once they allow our traffic.
  "triggers": { "crons": [] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lanterninha",
      "database_id": "9f3f154b-66fc-4254-b348-3ee34960a750",
      // Flat SQL files copied from drizzle/ by db/sync-migrations.ts.
      "migrations_dir": "migrations"
    }
  ]
}

{
  "name": "lanterninha",
  "private": true,
  "description": "Avaliações colaborativas de salas de cinema do Brasil.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && node db/sync-migrations.ts",
    "db:migrate:local": "wrangler d1 migrations apply lanterninha --local",
    "db:migrate:remote": "wrangler d1 migrations apply lanterninha --remote",
    "ancine:download": "node db/ancine/download.ts",
    "ancine:geocode": "node db/geo/geocode.ts",
    "ancine:build": "node db/ancine/import.ts",
    "demo:build": "node db/demo/generate.ts",
    "db:import:local": "wrangler d1 execute lanterninha --local --file db/ancine/import.sql",
    "db:demo:local": "wrangler d1 execute lanterninha --local --file db/demo/seed.sql",
    "db:import:remote": "wrangler d1 execute lanterninha --remote --file db/ancine/import.sql",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "lefthook install || echo \"lefthook: hooks not installed (no git?)\""
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.7.0-alpha.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "0.32.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  }
}
